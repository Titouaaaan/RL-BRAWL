// Up-tilt (light + up, on the ground): a quick arc above the head that
// launches straight up. Its job is anti-air (hitting someone jumping at you)
// and starting juggles: at low % the victim lands in range for an up-air.
// Frame data: 4 startup, hits on frames 5-9, recovery until frame 20.
// Knockback grows fast and the angle leans forward (80 degrees), so it only
// chains into itself at very low %: a first self-play run found an
// up-tilt -> up-tilt loop and used little else.
{
    "total_frames": 20,
    "landing_lag": 0,
    "hitboxes": [
        {"start": 5, "end": 9, "x": 0.6, "y": 3.2, "radius": 1.4,
         "damage": 6, "base_kb": 0.55, "kb_growth": 0.013, "angle": 80}
    ]
}
