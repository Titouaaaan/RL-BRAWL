    "total_frames": 32,
    "landing_lag": 0,
    "hitboxes": [
        {"start": 7, "end": 8, "x": 1.5, "y": 1.5, "radius": 1.0, "grab": true,
         "damage": 0, "base_kb": 0, "kb_growth": 0, "angle": 0}
    ]
}
