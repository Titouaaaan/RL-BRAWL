    "total_frames": 32,
    "landing_lag": 14,
    "hitboxes": [
        {"start": 8, "end": 11, "x": 0.2, "y": -0.2, "radius": 1.2,
         "damage": 12, "base_kb": 0.6, "kb_growth": 0.01, "angle": -80},
        {"start": 12, "end": 18, "x": 0.2, "y": 0.0, "radius": 1.0,
